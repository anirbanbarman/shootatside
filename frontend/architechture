                projectKey, severities, types, page, pageSize);
        int effectivePageSize = pageSize != null ? pageSize : 10;
        return listIssues(projectKey, severities, types, "OPEN,CONFIRMED,REOPENED", page, effectivePageSize);
    }

    // -----------------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------------

    private String resolveProjectKey(String provided) {
        String key = null;
        if (provided != null && !provided.isBlank()) {
            key = provided;
        } else if (props.getDefaultProjectKey() != null && !props.getDefaultProjectKey().isBlank()) {
            key = props.getDefaultProjectKey();
        } 
        
        if (key == null || key.isBlank()) {
            throw new IllegalArgumentException(
                "No SonarQube project key provided or found.\n" +
                "How to fix: " +
                "\n  1. Get it from info.app.uid in application.yml, application.yaml or application.properties file, " +
                "\n  2. If not found in application yml or property file then ask the user to give the service name" );
        }
        // If the key does not start with 'CLOUD_SERVICE:', prepend it
        if (!key.startsWith("CLOUD_SERVICE:")) {
            key = "CLOUD_SERVICE:" + key;
        }
        return key;
    }


    private String errorResponse(String message) {
        try {
            ObjectNode err = mapper.createObjectNode();
            err.put("error", message);
            return mapper.writerWithDefaultPrettyPrinter().writeValueAsString(err);
        } catch (Exception e) {
            return "{\"error\":\"" + message.replace("\"", "'") + "\"}";
        }
    }
}
```

## B.9 Step 7 — Application entry point

`src/main/java/com/lexmark/sonar/mcp/SonarMcpServerApplication.java`:

```java
package com.lexmark.sonar.mcp;

import com.lexmark.sonar.mcp.service.SonarQubeService;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.ai.tool.ToolCallbackProvider;
import org.springframework.ai.tool.method.MethodToolCallbackProvider;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.context.annotation.Bean;

import java.io.FilterInputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.ByteArrayOutputStream;
import java.nio.charset.StandardCharsets;

@SpringBootApplication
public class SonarMcpServerApplication {

    private static final Logger mcpLog = LoggerFactory.getLogger("MCP-STDIO");

    public static void main(String[] args) {
        System.setIn(loggingStdin(System.in));
        SpringApplication app = new SpringApplication(SonarMcpServerApplication.class);
        app.run(args);
        
        // Signal that the MCP server is ready
        mcpLog.info("======================================================================");
        mcpLog.info("MCP SERVER STARTED - Ready for requests");
        mcpLog.info("Available tools: sonar_list_issues, sonar_fix_issues");
        mcpLog.info("======================================================================");
    }

    /**
     * Wraps stdin so every complete newline-terminated JSON-RPC line from Copilot is logged.
     */
    private static InputStream loggingStdin(InputStream delegate) {
        return new FilterInputStream(delegate) {
            private final ByteArrayOutputStream buf = new ByteArrayOutputStream();

            @Override
            public int read() throws IOException {
                int b = in.read();
                if (b == '\n') {
                    mcpLog.info(">>> Copilot MCP request: {}", buf.toString(StandardCharsets.UTF_8));
                    buf.reset();
                } else if (b != -1) {
                    buf.write(b);
                }
                return b;
            }

            @Override
            public int read(byte[] b, int off, int len) throws IOException {
                int n = in.read(b, off, len);
                if (n > 0) {
                    for (int i = off; i < off + n; i++) {
                        if (b[i] == '\n') {
                            mcpLog.info(">>> Copilot MCP request: {}", buf.toString(StandardCharsets.UTF_8));
                            buf.reset();
                        } else {
                            buf.write(b[i]);
                        }
                    }
                }
                return n;
            }
        };
    }

    /**
     * Registers all @Tool-annotated methods from SonarQubeService as MCP tools.
     * GitHub Copilot will discover and invoke these tools to query SonarQube.
     */
    @Bean
    public ToolCallbackProvider sonarToolCallbackProvider(SonarQubeService sonarService) {
        return MethodToolCallbackProvider.builder().toolObjects(sonarService).build();
    }
}
