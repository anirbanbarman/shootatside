    public String listIssues(
            @ToolParam(description = "SonarQube project key (e.g., CLOUD_SERVICE:my-service). " +
                    "If not provided, will attempt to resolve from application configuration (application.yml/properties). " +
                    "If not found in config, an error will be thrown.", required = false)
            String projectKey,

            @ToolParam(description = "Comma-separated severities to filter on: BLOCKER,CRITICAL,MAJOR,MINOR,INFO. " +
                    "Defaults to BLOCKER,CRITICAL,MAJOR if not specified.", required = false)
            String severities,

