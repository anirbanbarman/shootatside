                projectKey, severities, types, statuses, page, pageSize);
        try {
            String key = resolveProjectKey(projectKey);
            Map<String, String> params = new HashMap<>();
            params.put("componentKeys", key);
            params.put("ps", String.valueOf(pageSize != null ? Math.min(pageSize, 500) : DEFAULT_PAGE_SIZE));
            params.put("p", String.valueOf(page != null ? page : 1));

            params.put("severities", (severities != null && !severities.isBlank())
                    ? severities.toUpperCase()
                    : "BLOCKER,CRITICAL,MAJOR");
            params.put("types", (types != null && !types.isBlank())
                    ? types.toUpperCase()
                    : "VULNERABILITY,BUG");
            params.put("statuses", statuses != null && !statuses.isBlank()
                    ? statuses.toUpperCase()
                    : "OPEN,CONFIRMED,REOPENED");

            JsonNode response = client.searchIssues(params);

            int total = response.path("total").asInt(0);
            int currentPage = response.path("p").asInt(1);
            int ps = response.path("ps").asInt(DEFAULT_PAGE_SIZE);
            int totalPages = (total + ps - 1) / ps;

            ArrayNode issues = (ArrayNode) response.path("issues");

            ObjectNode result = mapper.createObjectNode();
            result.put("projectKey", key);
            result.put("total", total);
            result.put("page", currentPage);
            result.put("pageSize", ps);
            result.put("totalPages", totalPages);

            ArrayNode summaries = mapper.createArrayNode();
            for (JsonNode issue : issues) {
                ObjectNode summary = mapper.createObjectNode();
                summary.put("key", issue.path("key").asText());
                summary.put("severity", issue.path("severity").asText());
                summary.put("type", issue.path("type").asText());
                summary.put("message", issue.path("message").asText());
                summary.put("rule", issue.path("rule").asText());
                summary.put("status", issue.path("status").asText());
                summary.put("component", issue.path("component").asText());
                summary.put("line", issue.path("line").asInt(0));
                summary.put("effort", issue.path("effort").asText("N/A"));
                summary.put("creationDate", issue.path("creationDate").asText());
                // Include text range so callers know the exact code location without an extra API call
                if (!issue.path("textRange").isMissingNode()) {
                    summary.set("textRange", issue.path("textRange"));
                }
                summaries.add(summary);
            }
            result.set("issues", summaries);

            // Fetch rule descriptions once per unique rule key and include as a shared map.
            // This replaces per-issue sonar_get_issue_detail calls when the goal is to fix issues.
            Map<String, ObjectNode> ruleCache = new HashMap<>();
            for (JsonNode issue : issues) {
                String ruleKey = issue.path("rule").asText();
                if (!ruleKey.isBlank() && !ruleCache.containsKey(ruleKey)) {
                    try {
                        JsonNode ruleResp = client.getRule(ruleKey);
                        JsonNode rule = ruleResp.path("rule");
                        ObjectNode ruleNode = mapper.createObjectNode();
                        ruleNode.put("name", rule.path("name").asText());
                        ruleNode.put("htmlDesc", rule.path("htmlDesc").asText());
                        ruleNode.put("severity", rule.path("severity").asText());
                        ruleNode.put("remFnType", rule.path("remFnType").asText());
                        ruleNode.put("remFnBaseEffort", rule.path("remFnBaseEffort").asText());
                        ruleCache.put(ruleKey, ruleNode);
                    } catch (Exception re) {
                        log.warn("Could not fetch rule '{}': {}", ruleKey, re.getMessage());
                    }
                }
            }
            if (!ruleCache.isEmpty()) {
                ObjectNode ruleDescriptions = mapper.createObjectNode();
                ruleCache.forEach(ruleDescriptions::set);
                result.set("ruleDescriptions", ruleDescriptions);
            }

            log.info("<<< [COPILOT TOOL CALL] sonar_list_issues | returned {} issues (total={} page={}/{})",
                    summaries.size(), total, currentPage, totalPages);
            return mapper.writerWithDefaultPrettyPrinter().writeValueAsString(result);
        } catch (Exception e) {
            log.error("!!! sonar_list_issues FAILED: {}", e.getMessage(), e);
            return errorResponse("Failed to list issues: " + e.getMessage());
        }
    }

