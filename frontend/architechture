## B.5 Step 3 — Resources

`src/main/resources/application.yml` — turns off the web server, enables the STDIO MCP server, and sets server-level instructions sent to the client on `initialize`:

```yaml
logging:
  level:
    org.springframework.boot.autoconfigure: OFF  # Suppress Spring Boot autoconfiguration report
    
spring:
  main:
    web-application-type: none   # No embedded web server needed for STDIO MCP
  ai:
    mcp:
      server:
        name: sonar-mcp-server
        version: 1.0.0
        type: SYNC
        stdio: true              # Enable STDIO transport for GitHub Copilot
        instructions: |
          MCP Server for SonarQube issue management and fixing.
          
          Available tools:
            - sonar_list_issues: Query and list SonarQube issues (no fixing)
            - sonar_fix_issues: Fix SonarQube issues with full 8-STEP workflow
          
          For detailed workflow instructions, see sonar_fix_issues tool description.
          
          ERROR HANDLING:
            - Max 3 attempts per step before stopping
            - Failed step will explicitly notify user with: "❌ FAILED - STEP X: [error details]"
            - No proceeding to next step if current step fails after 3 attempts
            - No proceeding to next page if current page fails

# SonarQube connection - REQUIRED environment variables:
#   SONAR_URL            - SonarQube base URL (REQUIRED)
#   SONAR_TOKEN          - SonarQube user/project token (REQUIRED)
# Optional environment variables:
#   SONAR_DEFAULT_PROJECT_KEY - default project key (used if not provided in tool params)
#   SONAR_SSL_VERIFY     - false to disable SSL verification (for self-signed certs)
```

`src/main/resources/logback-spring.xml` — **required**: routes every log line to stderr so stdout carries only MCP frames:

```xml
<?xml version="1.0" encoding="UTF-8"?>
<!-- Logback config: redirect ALL logging to stderr so stdout stays clean for MCP STDIO protocol -->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>

    <!-- Reduce noise from Spring/Jackson internals -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="com.fasterxml.jackson" level="WARN"/>
    <logger name="io.modelcontextprotocol" level="INFO"/>
    <logger name="com.lexmark.sonar" level="DEBUG"/>
</configuration>
```

## B.6 Step 4 — Configuration classes

`src/main/java/com/lexmark/sonar/mcp/config/SonarProperties.java`:

```java
package com.lexmark.sonar.mcp.config;

import org.springframework.boot.context.properties.ConfigurationProperties;
import org.springframework.stereotype.Component;
import jakarta.annotation.PostConstruct;
import java.net.URL;

/**
 * Configuration properties for SonarQube connection.
 * REQUIRED environment variables:
 *   SONAR_URL          → sonar.url (REQUIRED)
 *   SONAR_TOKEN        → sonar.token (REQUIRED)
 * Optional:
 *   SONAR_DEFAULT_PROJECT_KEY → sonar.default-project-key
 *   SONAR_SSL_VERIFY   → sonar.ssl-verify (set to false for self-signed certs)
 */
@Component
@ConfigurationProperties(prefix = "sonar")
public class SonarProperties {

    private String url;  // REQUIRED: must be provided via SONAR_URL environment variable
    private String token;  // REQUIRED: must be provided via SONAR_TOKEN environment variable
    // No default value for project key; must be provided
    private String defaultProjectKey;
    private boolean sslVerify = true;

    public String getUrl() {
        return url;
    }

    public void setUrl(String url) {
        this.url = url;
    }

    public String getToken() {
        return token;
    }

    public void setToken(String token) {
        this.token = token;
    }

    public String getDefaultProjectKey() {
        return defaultProjectKey;
    }

    public void setDefaultProjectKey(String defaultProjectKey) {
        this.defaultProjectKey = defaultProjectKey;
    }

    public boolean isSslVerify() {
        return sslVerify;
    }

    public void setSslVerify(boolean sslVerify) {
        this.sslVerify = sslVerify;
    }

    @PostConstruct
    public void validate() {
        if (url == null || url.isBlank()) {
            throw new IllegalArgumentException(
                "SONAR_URL is REQUIRED but not provided. " +
                "Set the environment variable: export SONAR_URL=https://your-sonar-instance");
        }
        try {
            new URL(url).toURI();
        } catch (Exception e) {
            throw new IllegalArgumentException(
                "SONAR_URL is invalid: " + url + ". Must be a valid URL (e.g., https://sonar.example.com)", e);
        }
        if (token == null || token.isBlank()) {
            throw new IllegalArgumentException(
                "SONAR_TOKEN is REQUIRED but not provided. " +
                "Set the environment variable: export SONAR_TOKEN=your-token");
        }
    }
}
```

