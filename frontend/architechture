    // Tool – List Issues (query-only, no fixing)
    // -----------------------------------------------------------------------

    @Tool(name = "sonar_list_issues",
            description = """
            Query and list SonarQube issues with optional filtering (QUERY ONLY - NO FIXING).
            
            This tool returns issues with complete information:
            - File paths, line numbers, textRange for precise code location
            - Rule keys and descriptions with remediation guidance
            - Severity, type, status, and effort estimates
            
