## B.7 Step 5 — SonarQube HTTP client

`src/main/java/com/lexmark/sonar/mcp/client/SonarQubeClient.java`:

```java
package com.lexmark.sonar.mcp.client;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.lexmark.sonar.mcp.config.SonarProperties;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;

import javax.net.ssl.SSLContext;
import javax.net.ssl.SSLParameters;
import javax.net.ssl.TrustManager;
import javax.net.ssl.X509TrustManager;
import java.io.IOException;
import java.net.URI;
import java.net.URLEncoder;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.charset.StandardCharsets;
import java.security.KeyManagementException;
import java.security.NoSuchAlgorithmException;
import java.security.cert.X509Certificate;
import java.time.Duration;
import java.util.Map;
import java.util.stream.Collectors;

/**
 * HTTP client for the SonarQube REST API.
 * Uses Java 11+ HttpClient with Bearer token authentication.
 */
@Component
public class SonarQubeClient {

    private static final Logger log = LoggerFactory.getLogger(SonarQubeClient.class);

    private final HttpClient httpClient;
    private final ObjectMapper objectMapper;
    private final SonarProperties props;

    public SonarQubeClient(SonarProperties props, ObjectMapper objectMapper)
            throws NoSuchAlgorithmException, KeyManagementException {
        this.props = props;
        this.objectMapper = objectMapper;
        
        // Validate required properties at startup
        if (props.getUrl() == null || props.getUrl().isBlank()) {
            throw new IllegalStateException(
                "SonarQube URL is not configured. Set SONAR_URL environment variable.");
        }
        if (props.getToken() == null || props.getToken().isBlank()) {
            throw new IllegalStateException(
                "SonarQube token is not configured. Set SONAR_TOKEN environment variable.");
        }
        
        this.httpClient = buildHttpClient(props.isSslVerify());
        log.info("SonarQubeClient initialized successfully. URL: {}", props.getUrl());
    }

    // -----------------------------------------------------------------------
    // Public API methods
    // -----------------------------------------------------------------------

    /**
     * Search issues: GET /api/issues/search
     * Supported params: componentKeys, severities, types, statuses, p, ps, s, asc
     */
    public JsonNode searchIssues(Map<String, String> params) throws IOException, InterruptedException {
        return get("/api/issues/search", params);
    }

    /**
     * Get a single issue by key with all additional fields.
     */
    public JsonNode getIssue(String issueKey) throws IOException, InterruptedException {
        return get("/api/issues/search", Map.of(
                "issues", issueKey,
                "additionalFields", "_all"
        ));
    }

    /**
     * Get project quality metrics: GET /api/measures/component
     */
    public JsonNode getProjectMetrics(String projectKey, String metricKeys)
            throws IOException, InterruptedException {
        return get("/api/measures/component", Map.of(
                "component", projectKey,
                "metricKeys", metricKeys
        ));
    }

    /**
     * Get rule details: GET /api/rules/show
     */
    public JsonNode getRule(String ruleKey) throws IOException, InterruptedException {
        return get("/api/rules/show", Map.of("key", ruleKey));
    }

    // -----------------------------------------------------------------------
    // Internal helpers
    // -----------------------------------------------------------------------

    private JsonNode get(String path, Map<String, String> params) throws IOException, InterruptedException {
        String query = params.entrySet().stream()
                .map(e -> URLEncoder.encode(e.getKey(), StandardCharsets.UTF_8)
                        + "=" + URLEncoder.encode(e.getValue(), StandardCharsets.UTF_8))
                .collect(Collectors.joining("&"));

        String url = props.getUrl() + path + (query.isBlank() ? "" : "?" + query);
        log.info("SonarQube GET: {}", url);

        HttpRequest.Builder requestBuilder = HttpRequest.newBuilder()
                .uri(URI.create(url))
                .timeout(Duration.ofSeconds(60))
                .header("Accept", "application/json")
                .GET();

        if (props.getToken() != null && !props.getToken().isBlank()) {
            requestBuilder.header("Authorization", "Bearer " + props.getToken());
        }

        HttpRequest request = requestBuilder.build();
        log.info(">>> Request: {} {}", request.method(), request.uri());
        request.headers().map().forEach((name, values) -> {
            if ("Authorization".equalsIgnoreCase(name)) {
                log.info(">>> Header: {}: Bearer [REDACTED]", name);
            } else {
                log.info(">>> Header: {}: {}", name, values);
            }
        });

        HttpResponse<String> response = httpClient.send(
                request, HttpResponse.BodyHandlers.ofString());
        log.info("<<< Response: HTTP {}", response.statusCode());
        // Only log response body at DEBUG level to avoid exposing sensitive project/issue data
        if (log.isDebugEnabled()) {
            log.debug("<<< Response body: {}", response.body());
        }

        if (response.statusCode() == 401) {
            throw new IOException("SonarQube authentication failed. Check SONAR_TOKEN.");
        }
        if (response.statusCode() == 403) {
            throw new IOException("SonarQube access denied. Token may lack permissions for this project.");
        }
        if (response.statusCode() >= 400) {
            throw new IOException("SonarQube API error HTTP " + response.statusCode() + ": " + response.body());
        }

        return objectMapper.readTree(response.body());
    }

    private HttpClient buildHttpClient(boolean sslVerify)
            throws NoSuchAlgorithmException, KeyManagementException {
        HttpClient.Builder builder = HttpClient.newBuilder()
                .connectTimeout(Duration.ofSeconds(30))
                .version(HttpClient.Version.HTTP_1_1);

        if (!sslVerify) {
            log.warn("!!! SSL certificate verification is DISABLED. This is unsafe and should only be used for self-signed certs in development. Do NOT use in production.");
            SSLContext ctx = SSLContext.getInstance("TLS");
            ctx.init(null, new TrustManager[]{
                    new X509TrustManager() {
                        public void checkClientTrusted(X509Certificate[] c, String a) { }
                        public void checkServerTrusted(X509Certificate[] c, String a) { }
                        public X509Certificate[] getAcceptedIssuers() { return new X509Certificate[0]; }
                    }
            }, new java.security.SecureRandom());
            builder.sslContext(ctx);

            // Disable hostname verification
            SSLParameters sslParameters = new SSLParameters();
            sslParameters.setEndpointIdentificationAlgorithm(null);
            builder.sslParameters(sslParameters);
        }

        return builder.build();
    }
