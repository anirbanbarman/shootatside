{
    "version": 2,
   "name": "shootatside-backend-final",
    "builds": [
         {
            "src": "server.js",
            "use": "@vercel/node",
            "config": {
               "includeFiles": "node_modules/swagger-ui-dist/**"
            }
         }
    ],
    "routes": [
         {
            "src": "/(.*)",
            "dest": "server.js"
         }
      ]
}