{
    "version": 2,
   "name": "shootatside-backend",
      "functions": {
         "server.js": {
            "includeFiles": "node_modules/swagger-ui-dist/**"
         }
      },
    "builds": [
      
      { "src": "server.js",
       "use": "@vercel/node" }
    ],
    "routes": [
       { "src": "/(.*)", 
       "dest": "server.js" }
    ]
 }